rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Only needed for subcollections, where `resource` refers to the child
    // doc, not the parent event — so the member role has to be fetched.
    function memberRole(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.members[request.auth.uid];
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow read: if isSignedIn() && resource.data.members[request.auth.uid] in ["admin", "crew", "viewer"];
      allow create: if isSignedIn() && request.resource.data.members[request.auth.uid] == "admin";
      allow update, delete: if isSignedIn() && resource.data.members[request.auth.uid] == "admin";

      match /items/{itemId} {
        allow read: if isSignedIn() && memberRole(eventId) in ["admin", "crew", "viewer"];
        allow create, delete: if isSignedIn() && memberRole(eventId) == "admin";
        allow update: if isSignedIn() && memberRole(eventId) in ["admin", "crew"];
      }

      match /activity/{logId} {
        allow read: if isSignedIn() && memberRole(eventId) in ["admin", "crew", "viewer"];
        allow create: if isSignedIn() && memberRole(eventId) in ["admin", "crew"];
        allow update, delete: if false;
      }

      match /imports/{importId} {
        allow read, write: if isSignedIn() && memberRole(eventId) == "admin";
      }
    }
  }
}
